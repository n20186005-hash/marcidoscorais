---
import "../styles/global.css";
import { siteConfig, type Lang } from "../config";
import { getJsonLd } from "../lib/schema";
import { languagesList, htmlLang, defaultLang } from "../i18n/ui";
import type { Translation } from "../i18n/translations";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  lang: Lang;
  t: Translation;
  page?: string; // 子页路径，如 "privacy" 或 "pontos-turisticos-maceio"，用于语言切换时保持同页
  title?: string; // 可选：自定义标题（优先于翻译中的 metaTitle）
  description?: string; // 可选：自定义描述（优先于翻译中的 metaDescription）
  noindex?: boolean; // 法律页等无检索价值页设为 true → noindex,follow
  availableLangs?: Lang[]; // 子页仅部分语言存在时，限制 hreflang 输出范围
}
const {
  lang,
  t,
  page = "",
  title,
  description,
  noindex = false,
  availableLangs,
} = Astro.props;

const baseUrl = siteConfig.baseUrl;
const pagePath = page ? `${page}` : "";
const canonical = pagePath
  ? `${baseUrl}/${lang}/${pagePath}`
  : `${baseUrl}/${lang}`;
const descriptionResolved =
  description ?? t.meta?.metaDescription ?? t.hero.subtitle;

const pageHtmlLang = htmlLang[lang];
const siteName = siteConfig.name[lang] ?? t.site.shortName;
const resolvedTitle =
  title ?? t.meta?.metaTitle ?? `${siteName} · ${t.site.tagline}`;
const jsonLd = getJsonLd(t, lang, baseUrl, pagePath, title);
const altLangs = availableLangs ?? languagesList;
const alternates = [
  {
    hreflang: "x-default",
    href: `${baseUrl}/${defaultLang}${pagePath ? "/" + pagePath : ""}`,
  },
  ...altLangs.map((l) => ({
    hreflang: htmlLang[l],
    href: `${baseUrl}/${l}${pagePath ? "/" + pagePath : ""}`,
  })),
];
---

<!doctype html>
<html lang={pageHtmlLang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={descriptionResolved} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="theme-color" content="#0e7490" />

    <!-- hreflang alternates -->
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={a.href} />
      ))
    }

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={descriptionResolved} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={`${baseUrl}${siteConfig.ogImage}`} />
    <meta property="og:locale" content={pageHtmlLang.replace("-", "_")} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={descriptionResolved} />
    <meta name="twitter:image" content={`${baseUrl}${siteConfig.ogImage}`} />

    <!-- Google Analytics (gtag.js) -->
    <script
      is:inline
      src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.gaId}`}
    ></script>
    <script
      is:inline
      define:vars={{ gaId: siteConfig.gaId }}
    >
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", gaId);
    </script>

    <!-- 防止主题闪烁：在首屏渲染前应用已保存的主题 -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme =
            stored ||
            (window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body class="bg-canvas text-ink antialiased">
    <Header lang={lang} t={t} page={page} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} t={t} page={page} />
    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
