---
import type { Lang } from "../config";
import { nearbyCopy } from "../i18n/interface-copy";
import { maceioPlaces } from "../data/maceio-places";
import { pajucaraGuides } from "../data/pajucara-guides";

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = nearbyCopy[lang];
const nearby = Object.entries({ ...pajucaraGuides, ...maceioPlaces });
const areas = [...new Set(nearby.map(([, topic]) => topic.eyebrow))];
---
<section class="section section--alt" id="arredores">
  <div class="container">
    <div class="section-head">
      <h2 class="section-head__title">{copy.title}</h2>
      <p class="section-head__subtitle">{copy.intro}</p>
    </div>
    {lang === "pt" ? <div class="grid grid-3">
      {areas.map((area) => (
        <div class="card">
          <h3 class="card__title">{area}</h3>
          <ul class="tip-list">
            {nearby.filter(([, topic]) => topic.eyebrow === area).map(([slug, topic]) => (
              <li><a class="underline" href={`/pt/${slug}`}>{topic.title}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div> : (
      <a class="btn btn--outline" href="/pt#arredores">{copy.directory}</a>
    )}
  </div>
</section>
