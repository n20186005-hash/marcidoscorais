---
import { siteConfig, type Lang } from "../config";
import type { Translation } from "../i18n/translations";

interface Props {
  lang: Lang;
  t: Translation;
}
const { t } = Astro.props;
---

<section id="location" class="section section--alt">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-head__eyebrow">{t.location.eyebrow}</span>
      <h2 class="section-head__title">{t.location.title}</h2>
      <p class="section-head__subtitle">{t.location.subtitle}</p>
    </div>

    <div class="prose reveal" style="text-align:center">
      {t.location.intro}
    </div>

    <div class="location-grid reveal" style="margin-top:32px">
      <div class="map-wrap">
        <iframe
          src={siteConfig.mapsEmbed}
          title={t.location.title}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <div>
        <div class="contact-card">
          <div class="contact-card__row">
            <div class="contact-card__icon">📍</div>
            <div>
              <div style="font-weight:600">{t.location.address}</div>
              <a
                class="btn btn--outline"
                style="margin-top:10px; padding:8px 16px; font-size:0.88rem"
                href={siteConfig.mapsUrl}
                target="_blank"
                rel="noopener">{t.location.openMaps}</a
              >
            </div>
          </div>
          <div class="contact-card__row">
            <div class="contact-card__icon">📞</div>
            <div>
              <div style="font-weight:600">{t.location.contact.phone}</div>
              <div style="font-size:0.85rem; color:var(--color-text-muted)">
                {t.location.contact.note}
              </div>
            </div>
          </div>
        </div>

        <ul class="tip-list">
          {t.location.tips.map((tip) => <li>{tip}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
