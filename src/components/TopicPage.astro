---
import { interfaceCopy, nearbyCopy } from "../i18n/interface-copy";
import type { Lang } from "../config";
import type { getNearbyVisitPlan } from "../i18n/nearby-guides";
import TopicSection from "./TopicSection.astro";
import type { TopicContent } from "../i18n/topics";
import { getTopic } from "../i18n/topics";
import type { Translation } from "../i18n/translations";

interface Props {
  lang: Lang;
  topic: TopicContent;
  t: Translation;
  visitPlan?: ReturnType<typeof getNearbyVisitPlan>;
}
const { lang, topic, t, visitPlan } = Astro.props;
const labels = interfaceCopy[lang].topic;
const mapsSearch = (query: string) => {
  const params = new URLSearchParams({ api: "1", query });
  if (topic.location?.query === query && topic.location.placeId) {
    params.set("query_place_id", topic.location.placeId);
  }
  return `https://www.google.com/maps/search/?${params}`;
};

const earlyOrder = ["planeje-a-visita", "planejamento"];
const discoverySections = visitPlan ? topic.sections.filter(({ id }) => id === "o-que-observar" || id === "orla") : [];
const earlySections = visitPlan ? earlyOrder.flatMap((id) => topic.sections.filter((section) => section.id === id)) : [];
const photoSections = visitPlan ? topic.sections.filter(({ id }) => id === "fotos") : [];
const mainSections = topic.sections.filter((section) => !earlySections.includes(section) && !photoSections.includes(section) && !discoverySections.includes(section));
const rating = topic.reviewPlaces?.find(({ snapshot }) => snapshot)?.snapshot;
const directionsDestination = visitPlan?.kind === "lighthouse"
  ? "Marco dos Corais, Ponta Verde, Maceió, AL"
  : visitPlan?.kind === "boat"
    ? "Embarque de Jangadas, Praia de Pajuçara, Maceió, AL"
    : topic.location?.query;
const mapDirections = directionsDestination && new URLSearchParams({
  api: "1",
  destination: directionsDestination,
});

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: topic.faq.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.answer,
    },
  })),
};

const nextStop = visitPlan && getTopic(lang, visitPlan.nextStop);
const quickFacts = visitPlan && topic.visitorInfo ? [
  [labels.type, labels.kinds[visitPlan.kind]],
  [labels.location, topic.location?.address],
  [labels.management, topic.visitorInfo.management],
  [labels.duration, `${visitPlan.minutes} ${labels.minutes}`],
  [labels.opening, visitPlan.hours],
  [labels.tickets, visitPlan.fee],
  [labels.access, topic.visitorInfo.access],
] : [];

const relatedSlugs = visitPlan ? [...new Set([visitPlan.nextStop, ...topic.related])] : topic.related;
const pageSections = [
  ["dicas-de-visita", labels.visitTips],
  ["informacoes", labels.atAGlance],
  ["descobrir", labels.discover],
  ["roteiro-da-visita", labels.itinerary],
  [photoSections[0]?.id ?? "fotos-do-roteiro", labels.photoTips],
  ["hospedagem", labels.stay],
  ["localizacao", labels.mapSection],
] as const;
const related = relatedSlugs
  .map((slug) => ({ slug, content: getTopic(lang, slug) }))
  .filter((r) => r.content) as { slug: string; content: TopicContent }[];
---

<article class="topic-page">
<section class="section topic-page__intro">
  <div class="container">
    <div class="section-head">
      <span class="section-head__eyebrow">{topic.eyebrow}</span>
      <h1 class="section-head__title">{topic.title}</h1>
      <p class="section-head__subtitle">{topic.intro}</p>
      {visitPlan && (
        <div class="mt-4 space-y-2">
          <p><strong>{labels.hours}</strong> · {visitPlan.hours}</p>
          <p><a class="underline" href="#avaliacoes">{rating?.text ?? labels.currentRating}</a></p>
        </div>
      )}
      {topic.location && (
        <a class="btn btn--outline mt-3 inline-block" href={mapsSearch(topic.location.query)} target="_blank" rel="noopener">{interfaceCopy[lang].map}</a>
      )}
    </div>
  </div>
</section>

{topic.photo && (
  <figure class="container">
    <img class="mx-auto block h-auto max-h-[520px] w-auto max-w-full rounded-xl" src={topic.photo.src}
      alt={topic.photo.alt} width={topic.photo.width} height={topic.photo.height} decoding="async" />
    <figcaption class="mt-2 text-center text-sm text-muted">
      <a class="underline" href={topic.photo.source}>{topic.photo.credit}</a>
    </figcaption>
  </figure>
)}

{visitPlan && (
  <nav class="container mt-6" aria-label={labels.pageContents}>
    <ul class="flex flex-wrap justify-center gap-x-4 gap-y-2">
      {pageSections.map(([id, label]) => <li><a class="underline" href={`#${id}`}>{label}</a></li>)}
    </ul>
  </nav>
)}

{visitPlan && (
  <section id="dicas-de-visita" class="section">
    <div class="container grid grid-2">
      <div class="card">
        <h2 class="card__title">{labels.visitTips}</h2>
        <p>{visitPlan.advice}</p>
      </div>
      <div class="card" id="destaques">
        <h2 class="card__title">{labels.highlights}</h2>
        <p>{visitPlan.highlight}</p>
      </div>
    </div>
  </section>
)}

{earlySections.map((section) => <TopicSection section={section} />)}

{topic.visitorInfo && (
  <section id="informacoes" class="section section--alt">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head__title">{topic.visitorInfo.heading ?? labels.about}</h2>
        <p class="section-head__subtitle"><strong>{labels.management}</strong> · {topic.visitorInfo.management}</p>
        {!visitPlan && topic.visitorInfo.background && <p class="section-head__subtitle">{topic.visitorInfo.background}</p>}
      </div>
      {visitPlan ? (
        <table class="topic-page__facts">
          <caption>{labels.atAGlance}</caption>
          <tbody>
            {quickFacts.map(([label, value]) => value && (
              <tr><th scope="row">{label}</th><td>{value}</td></tr>
            ))}
          </tbody>
        </table>
      ) : (
        <>
          <h3 class="card__title">{labels.practical}</h3>
          <dl class="grid grid-2">
            <div class="card"><dt class="card__title">{labels.type}</dt><dd>{topic.visitorInfo.type}</dd></div>
            <div class="card"><dt class="card__title">{labels.access}</dt><dd>{topic.visitorInfo.access}</dd></div>
            <div class="card"><dt class="card__title">{labels.transport}</dt><dd>{topic.visitorInfo.transport}</dd></div>
            {topic.location && <div class="card"><dt class="card__title">{labels.location}</dt><dd>{topic.location.address}</dd></div>}
          </dl>
        </>
      )}
      {visitPlan && (
        <div class="grid grid-2 mt-4">
          <section class="card" id="horario"><h3 class="card__title">{labels.opening}</h3><p>{visitPlan.hours}</p></section>
          <section class="card" id="ingresso"><h3 class="card__title">{labels.tickets}</h3><p>{visitPlan.fee}</p></section>
        </div>
      )}
      {visitPlan && (
        <section class="card mt-4" id="transporte">
          <h3 class="card__title">{labels.transport}</h3>
          <p>{topic.visitorInfo.transport}</p>
        </section>
      )}
    </div>
  </section>
)}

{visitPlan && (
  <section id="descobrir" class="section">
    <div class="container">
      <div class="section-head"><h2 class="section-head__title">{labels.discover}</h2></div>
      {topic.visitorInfo?.background && <p class="prose">{topic.visitorInfo.background}</p>}
    </div>
  </section>
)}
{discoverySections.map((section) => <TopicSection section={section} />)}
{mainSections.map((section) => <TopicSection section={section} />)}

{visitPlan && (
  <>
    <section id="roteiro-da-visita" class="section section--alt">
      <div class="container">
        <div class="section-head"><h2 class="section-head__title">{labels.itinerary}</h2></div>
        <ol class="list-decimal space-y-2 pl-6">
          {visitPlan.route.map((step) => <li>{step}</li>)}
        </ol>
        {nextStop && (
          <p class="mt-4"><strong>{labels.pairWith}</strong> · <a class="underline" href={`/${lang}/${visitPlan.nextStop}`}>{nextStop.title}</a></p>
        )}
      </div>
    </section>
    <section id="orientacoes" class="section">
      <div class="container">
        <div class="section-head"><h2 class="section-head__title">{labels.visitNotice}</h2></div>
        <ul class="tip-list">
          <li>{visitPlan.notice}</li>
          {topic.visitorInfo && <li>{topic.visitorInfo.access}</li>}
        </ul>
      </div>
    </section>
    {photoSections.map((section) => <TopicSection section={section} />)}
    {visitPlan.photoTip && (
      <section id="fotos-do-roteiro" class="section">
        <div class="container">
          <div class="section-head"><h2 class="section-head__title">{labels.photoTips}</h2></div>
          <p>{visitPlan.photoTip}</p>
        </div>
      </section>
    )}
    <section id="hospedagem" class="section">
      <div class="container">
        <div class="section-head"><h2 class="section-head__title">{labels.stay}</h2></div>
        <p>{visitPlan.stay}</p>
      </div>
    </section>
  </>
)}

<section id="faq" class="section section--alt">
  <div class="container">
    <div class="section-head">
      <span class="section-head__eyebrow">{t.faq.eyebrow}</span>
      <h2 class="section-head__title">{t.faq.title}</h2>
      <p class="section-head__subtitle">{t.faq.subtitle}</p>
    </div>
    <div class="grid grid-2">
      {
        topic.faq.map((f) => (
          <div class="card">
            <h3 class="card__title">{f.question}</h3>
            <div class="prose">
              <p>{f.answer}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

{topic.reviewPlaces?.length && (
  <section id="avaliacoes" class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head__title">{labels.reviews}</h2>
      </div>
      <ul class="tip-list">
        {topic.reviewPlaces.map(({ label, query, snapshot }) => (
          <li>
            <div>
              <a class="underline" href={mapsSearch(query)} target="_blank" rel="noopener">{labels.reviewsOf.replace("{place}", label)}</a>
              {snapshot && <p>{snapshot.text} · <a class="underline" href={snapshot.source}>{labels.snapshot}</a></p>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

{
  topic.location && (
    <section id="localizacao" class="section section--alt">
      <div class="container">
        <div class="section-head">
          <h2 class="section-head__title">{labels.mapSection}</h2>
          <p class="section-head__subtitle">{topic.location.address}</p>
        </div>
        <a class="btn btn--outline" href={mapsSearch(topic.location.query)} target="_blank" rel="noopener">
          {labels.openMap}
        </a>
        {visitPlan && !topic.location.directions && mapDirections && (
          <a class="btn btn--outline" href={`https://www.google.com/maps/dir/?${mapDirections}`} target="_blank" rel="noopener">
            {labels.directions}
          </a>
        )}
        {topic.location.directions && (
          <a class="btn btn--outline" href={topic.location.directions} target="_blank" rel="noopener">
            {labels.walking}
          </a>
        )}
      </div>
    </section>
  )
}

{
  (visitPlan || related.length > 0) && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2 class="section-head__title">{t.footer.guidesTitle}</h2>
          {visitPlan && <p class="section-head__subtitle">{labels.relatedIntro}</p>}
        </div>
        <div class="grid grid-3">
          {related.map((r) => (
            <a class="card no-underline" href={`/${lang}/${r.slug}`}>
              <h3 class="card__title">{r.content.title}</h3>
              <p class="card__text">{r.content.intro}</p>
              <span class="btn btn--outline mt-3 inline-block">
                {labels.readGuide}
              </span>
            </a>
          ))}
        </div>
        {visitPlan && (
          <div class="card mt-6">
            <h3 class="card__title">{nearbyCopy[lang].title}</h3>
            <p class="card__text">{nearbyCopy[lang].intro}</p>
            <a class="btn btn--outline mt-3" href={`/${lang}#arredores`}>{labels.allNearby}</a>
          </div>
        )}
      </div>
    </section>
  )
}

{
  topic.sources && (
    <section id="fontes" class="section">
      <div class="container">
        <div class="section-head">
          <h2 class="section-head__title">{labels.sources}</h2>
        </div>
        <ul class="tip-list">
          {topic.sources.map(({ label, href }) => (
            <li><a class="underline" href={href}>{label}</a></li>
          ))}
        </ul>
      </div>
    </section>
  )
}

</article>

<script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>

<style>
  .topic-page {
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  .topic-page__intro .section-head {
    margin-bottom: 0;
  }

  .topic-page :global(.section-head__title) {
    text-wrap: balance;
  }

  .topic-page :global(.grid > *),
  .topic-page :global(.tip-list li > *) {
    min-inline-size: 0;
  }

  .topic-page :global(.card) {
    padding: clamp(16px, 2.5vw, 24px);
    border-radius: var(--radius-md);
  }

  .topic-page__facts {
    width: 100%;
    table-layout: fixed;
    background: var(--color-surface);
  }

  .topic-page__facts caption {
    font-weight: 700;
    padding-block-end: 12px;
    text-align: start;
  }

  .topic-page__facts th,
  .topic-page__facts td {
    border-block-end: 1px solid var(--color-border);
    padding: clamp(8px, 2vw, 16px);
    text-align: start;
    vertical-align: top;
  }

  .topic-page__facts th {
    width: 34%;
  }

  .topic-page :global(.btn) {
    max-inline-size: 100%;
    text-align: center;
  }
</style>
