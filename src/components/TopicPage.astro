---
import { siteConfig, type Lang } from "../config";
import type { TopicContent } from "../i18n/topics";
import { getTopic } from "../i18n/topics";
import type { Translation } from "../i18n/translations";

interface Props {
  lang: Lang;
  topic: TopicContent;
  t: Translation;
}
const { lang, topic, t } = Astro.props;
const mapsSearch = (query: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: topic.faq.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.answer,
    },
  })),
};

const related = topic.related
  .map((slug) => ({ slug, content: getTopic(lang, slug) }))
  .filter((r) => r.content) as { slug: string; content: TopicContent }[];
---

<section class="section">
  <div class="container">
    <div class="section-head">
      <span class="section-head__eyebrow">{topic.eyebrow}</span>
      <h1 class="section-head__title">{topic.title}</h1>
      <p class="section-head__subtitle">{topic.intro}</p>
      {topic.photo && topic.location && (
        <a class="btn btn--outline mt-3 inline-block" href={mapsSearch(topic.location.query)} target="_blank" rel="noopener">Ver no mapa</a>
      )}
    </div>
  </div>
</section>

{topic.photo && (
  <figure class="container">
    <img class="mx-auto block h-auto max-h-[520px] w-auto max-w-full rounded-xl" src={topic.photo.src}
      alt={topic.photo.alt} width={topic.photo.width} height={topic.photo.height} decoding="async" />
    <figcaption class="mt-2 text-center text-sm text-muted">
      <a class="underline" href={topic.photo.source}>{topic.photo.credit}</a>
    </figcaption>
  </figure>
)}

{topic.visitorInfo && (
  <section id="informacoes" class="section section--alt">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head__title">{topic.visitorInfo.heading ?? "Sobre o local"}</h2>
        <p class="section-head__subtitle"><strong>Gestão do local</strong> · {topic.visitorInfo.management}</p>
        {topic.visitorInfo.background && <p class="section-head__subtitle">{topic.visitorInfo.background}</p>}
      </div>
      <h3 class="card__title">Informações práticas</h3>
      <dl class="grid grid-2">
        <div class="card"><dt class="card__title">Tipo de visita</dt><dd>{topic.visitorInfo.type}</dd></div>
        <div class="card"><dt class="card__title">Acesso e funcionamento</dt><dd>{topic.visitorInfo.access}</dd></div>
        <div class="card"><dt class="card__title">Como chegar</dt><dd>{topic.visitorInfo.transport}</dd></div>
        {topic.location && <div class="card"><dt class="card__title">Localização</dt><dd>{topic.location.address}</dd></div>}
      </dl>
    </div>
  </section>
)}

{
  topic.sections.map((sec) => (
    <section id={sec.id} class="section">
      <div class="container">
        <div class="section-head">
          <h2 class="section-head__title">{sec.title}</h2>
        </div>
        <div class="prose">
          {sec.blocks.map((b) => {
            if (b.type === "p") {
              return <p>{b.text}</p>;
            }
            if (b.type === "steps") {
              return <ol class="list-decimal space-y-2 pl-6">{b.items.map((item) => <li>{item}</li>)}</ol>;
            }
            if (b.type === "list") {
              return (
                <ul class="tip-list">
                  {b.items.map((i) => (
                    <li>{i}</li>
                  ))}
                </ul>
              );
            }
            return (
              <div class="my-4 rounded-xl border-l-4 border-coral bg-coral/10 p-4 text-ink/90">
                {b.text}
              </div>
            );
          })}
          {sec.links?.map(({ label, href }) => <p><a class="underline" href={href}>{label}</a></p>)}
        </div>
      </div>
    </section>
  ))
}

{
  topic.location && (
    <section id="localizacao" class="section section--alt">
      <div class="container">
        <div class="section-head">
          <h2 class="section-head__title">Localização e rota</h2>
          <p class="section-head__subtitle">{topic.location.address}</p>
        </div>
        <a class="btn btn--outline" href={mapsSearch(topic.location.query)} target="_blank" rel="noopener">
          Abrir ponto no Google Maps
        </a>
        {topic.location.directions && (
          <a class="btn btn--outline" href={topic.location.directions} target="_blank" rel="noopener">
            Ver percurso a pé
          </a>
        )}
      </div>
    </section>
  )
}

<section id="faq" class="section section--alt">
  <div class="container">
    <div class="section-head">
      <span class="section-head__eyebrow">{t.faq.eyebrow}</span>
      <h2 class="section-head__title">{t.faq.title}</h2>
      <p class="section-head__subtitle">{t.faq.subtitle}</p>
    </div>
    <div class="grid grid-2">
      {
        topic.faq.map((f) => (
          <div class="card">
            <h3 class="card__title">{f.question}</h3>
            <div class="prose">
              <p>{f.answer}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

{topic.reviewPlaces?.length && (
  <section id="avaliacoes" class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head__title">Avaliações no Google Maps</h2>
      </div>
      <ul class="tip-list">
        {topic.reviewPlaces.map(({ label, query, snapshot }) => (
          <li>
            <a class="underline" href={mapsSearch(query)} target="_blank" rel="noopener">Ver avaliações de {label}</a>
            {snapshot && <p>{snapshot.text} · <a class="underline" href={snapshot.source}>Registro publicado pelo Prime Gourmet</a></p>}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

{
  related.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2 class="section-head__title">{t.footer.guidesTitle}</h2>
        </div>
        <div class="grid grid-3">
          {related.map((r) => (
            <a class="card no-underline" href={`/${lang}/${r.slug}`}>
              <h3 class="card__title">{r.content.title}</h3>
              <p class="card__text">{r.content.intro}</p>
              <span class="btn btn--outline mt-3 inline-block">
                {t.hero.secondaryCta.label}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  topic.sources && (
    <section id="fontes" class="section">
      <div class="container">
        <div class="section-head">
          <h2 class="section-head__title">Fontes</h2>
        </div>
        <ul class="tip-list">
          {topic.sources.map(({ label, href }) => (
            <li><a class="underline" href={href}>{label}</a></li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>
