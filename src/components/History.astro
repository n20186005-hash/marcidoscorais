---
import { type Lang } from "../config";
import { renderRichText } from "../lib/richtext";
import type { Translation } from "../i18n/translations";

interface Props {
  lang: Lang;
  t: Translation;
}
const { t } = Astro.props;
---

<section
  id="history"
  class="bg-canvas px-4 py-24 scroll-mt-[calc(var(--nav-h)+24px)] sm:px-6 sm:py-28 lg:px-8"
>
  <div class="mx-auto w-full max-w-6xl">
    <!-- Header: eyebrow / title / subtitle 统一左对齐，纵向间距清晰 -->
    <div class="reveal max-w-2xl">
      <span
        class="inline-block rounded-full bg-ocean/10 px-4 py-1.5 text-sm font-semibold text-ocean"
        >{t.history.eyebrow}</span
      >
      <h2
        class="mt-4 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl"
      >
        {t.history.title}
      </h2>
      <p class="mt-3 text-base leading-relaxed text-muted">{t.history.subtitle}</p>
    </div>

    <!-- Intro: 与标题左对齐，移除 .prose 居中导致的错位 -->
    <div
      class="reveal mt-6 max-w-3xl text-base leading-relaxed text-ink/90"
      set:html={renderRichText(t.history.intro)}
    >
    </div>

    <!-- Highlights: 独立的 3 列响应式 Grid -->
    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.history.highlights.map((h) => (
          <article class="reveal flex h-full flex-col rounded-xl border border-line bg-surface p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
            <div class="grid h-12 w-12 place-items-center rounded-xl bg-ocean/10 text-2xl">
              {h.icon}
            </div>
            <h3 class="mt-4 text-lg font-bold text-ink">{h.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{h.text}</p>
          </article>
        ))
      }
    </div>

    <!-- Timeline: 独立的 2 列响应式 Grid，年份作为 Badge 不压标题 -->
    <div class="mt-12 grid grid-cols-1 gap-6 border-t border-line pt-10 lg:grid-cols-2">
      {
        t.history.timeline.map((item) => (
          <article class="reveal flex h-full flex-col rounded-xl border border-line bg-surface p-5 shadow-sm">
            <div class="flex flex-wrap items-center gap-3">
              <span class="inline-flex w-fit shrink-0 items-center rounded-lg bg-ocean px-3 py-1.5 text-sm font-bold leading-none text-white">
                {item.year}
              </span>
              <h3 class="min-w-0 flex-1 text-lg font-bold leading-snug text-ink">{item.title}</h3>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-muted">{item.text}</p>
          </article>
        ))
      }
    </div>

    <!-- Local life: 独立的 2 列响应式 Grid -->
    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        t.history.localLife.map((item) => (
          <div class="reveal rounded-xl border border-line bg-surface p-5 shadow-sm">
            <h3 class="text-lg font-bold text-ink">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
