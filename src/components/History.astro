---
import { type Lang } from "../config";
import { renderRichText } from "../lib/richtext";
import type { Translation } from "../i18n/translations";

interface Props {
  lang: Lang;
  t: Translation;
}
const { t } = Astro.props;
---

<section id="history" class="bg-canvas px-4 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto w-full max-w-[1120px]">
    <div class="reveal max-w-2xl">
      <span
        class="inline-block rounded-full bg-ocean/10 px-4 py-1.5 text-sm font-semibold text-ocean"
        >{t.history.eyebrow}</span
      >
      <h2
        class="mt-4 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl"
      >
        {t.history.title}
      </h2>
      <p class="mt-3 text-muted">{t.history.subtitle}</p>
    </div>

    <div
      class="prose reveal mt-8 max-w-3xl text-ink/90"
      set:html={renderRichText(t.history.intro)}
    >
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.history.highlights.map((h) => (
          <article class="reveal rounded-2xl border border-line bg-surface p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
            <div class="grid h-12 w-12 place-items-center rounded-xl bg-ocean/10 text-2xl">
              {h.icon}
            </div>
            <h3 class="mt-4 text-lg font-bold text-ink">{h.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{h.text}</p>
          </article>
        ))
      }
    </div>

    <div
      class="mt-12 grid gap-6 border-t border-line pt-10 lg:grid-cols-2"
    >
      {
        t.history.timeline.map((item) => (
          <div class="reveal flex gap-4">
            <div class="shrink-0 rounded-xl bg-ocean px-3 py-2 text-sm font-bold text-white">
              {item.year}
            </div>
            <div>
              <h3 class="text-lg font-bold text-ink">{item.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{item.text}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        t.history.localLife.map((item) => (
          <div class="reveal rounded-2xl border border-line bg-surface-2 p-6">
            <h3 class="text-lg font-bold text-ink">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
