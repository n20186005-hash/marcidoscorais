---
import { type Lang } from "../config";
import type { Translation } from "../i18n/translations";

interface Props {
  lang: Lang;
  t: Translation;
}
const { t } = Astro.props;
---

<!-- 限高容器：严禁无休止拉长；背景图绝对铺满 + 半透明遮罩 -->
<section
  id="top"
  class="relative w-full h-[60vh] min-h-[480px] max-h-[600px] overflow-hidden"
>
  <img
    src="/gallery/21.jpg"
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-black/40"></div>

  <!-- 内容底部对齐 -->
  <div
    class="relative z-10 mx-auto flex h-full max-w-5xl flex-col justify-end px-4 pb-12 text-white"
  >
    <span
      class="inline-flex w-fit items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-sm font-medium backdrop-blur-md"
    >
      📍 {t.hero.eyebrow}
    </span>

    <h1
      class="mt-4 text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl lg:text-6xl"
    >
      {t.hero.title}
    </h1>

    <p
      class="mt-3 max-w-2xl text-base leading-relaxed text-white/90 sm:text-lg"
    >
      {t.hero.subtitle}
    </p>

    <div class="mt-6 flex flex-wrap gap-4">
      <a
        class="rounded-full bg-coral px-6 py-3 text-sm font-bold text-white shadow-lg transition hover:brightness-105"
        href={t.hero.primaryCta.href}
      >
        {t.hero.primaryCta.label}
      </a>
      <a
        class="rounded-full border border-white/70 bg-white/10 px-6 py-3 text-sm font-bold backdrop-blur-md transition hover:bg-white/20"
        href={t.hero.secondaryCta.href}
      >
        {t.hero.secondaryCta.label}
      </a>
    </div>

    <div
      class="mt-8 grid max-w-2xl grid-cols-2 gap-4 sm:grid-cols-3"
    >
      {
        t.hero.stats.map((s) => (
          <div class="rounded-2xl bg-white/10 p-4 text-center ring-1 ring-white/20 backdrop-blur-md">
            <div class="text-2xl font-extrabold text-white">{s.num}</div>
            <div class="mt-1 text-xs font-medium text-white/80">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>

  <div
    class="absolute bottom-4 left-1/2 z-10 -translate-x-1/2 text-2xl text-white/80"
    aria-hidden="true"
  >
    ↓
  </div>
</section>
