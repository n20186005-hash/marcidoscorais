---
import { interfaceCopy, nearbyCopy } from "../i18n/interface-copy";
import { siteConfig, type Lang } from "../config";
import type { Translation } from "../i18n/translations";
import { getTopic } from "../i18n/topics";

interface Props {
  lang: Lang;
  t: Translation;
}
const { lang, t } = Astro.props;
const mapsUrl = siteConfig.mapsUrl;
const sunsetTopic = getTopic(lang, "por-do-sol-marco-dos-corais");
const sunsetHref = sunsetTopic
  ? `/${lang}/por-do-sol-marco-dos-corais`
  : "#top";
---

<!-- Keep the photo behind the content as the hero grows with wrapped text. -->
<section
  id="top"
  class="home-hero relative grid w-full min-h-[clamp(480px,60vh,600px)] overflow-hidden"
>
  <img
    src="/gallery/21.jpg"
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="home-hero__shade absolute inset-0"></div>

  <!-- 内容底部对齐 -->
  <div
    class="container home-hero__content relative z-10 flex min-w-0 flex-col justify-end text-white"
  >
    <span
      class="inline-flex max-w-full w-fit items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-sm font-medium backdrop-blur-md"
    >
      📍 {t.hero.eyebrow}
    </span>

    <h1
      class="mt-4 [overflow-wrap:anywhere] text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl lg:text-6xl"
    >
      {t.hero.title}
    </h1>

    <p
      class="mt-3 max-w-2xl [overflow-wrap:anywhere] text-base leading-relaxed text-white/90 sm:text-lg"
    >
      {t.hero.subtitle}
    </p>

    <div class="mt-6 flex flex-wrap gap-4">
      <a
        class="rounded-full bg-coral px-6 py-3 text-sm font-bold text-white shadow-lg transition hover:brightness-105"
        href={t.hero.primaryCta.href}
      >
        {t.hero.primaryCta.label}
      </a>
      <a
        class="rounded-full border border-white/70 bg-white/10 px-6 py-3 text-sm font-bold backdrop-blur-md transition hover:bg-white/20"
        href={t.hero.secondaryCta.href}
      >
        {t.hero.secondaryCta.label}
      </a>
    </div>

    <!-- 移动端优先的快捷入口：直达到达 / 地图 / 日落 / 照片 -->
    <div class="mt-5 flex flex-wrap gap-2">
      <a
        class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3.5 py-2 text-sm font-semibold text-white ring-1 ring-white/25 backdrop-blur-md transition hover:bg-white/25"
        href="#location"
      >
        🧭 {t.hero.primaryCta.label}
      </a>
      <a
        class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3.5 py-2 text-sm font-semibold text-white ring-1 ring-white/25 backdrop-blur-md transition hover:bg-white/25"
        href={mapsUrl}
        target="_blank"
        rel="noopener"
      >
        🗺️ {interfaceCopy[lang].map}
      </a>
      {
        sunsetTopic && (
          <a
            class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3.5 py-2 text-sm font-semibold text-white ring-1 ring-white/25 backdrop-blur-md transition hover:bg-white/25"
            href={sunsetHref}
          >
            🌅 {interfaceCopy[lang].sunset}
          </a>
        )
      }
      <a
        class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3.5 py-2 text-sm font-semibold text-white ring-1 ring-white/25 backdrop-blur-md transition hover:bg-white/25"
        href="#gallery"
      >
        📷 {interfaceCopy[lang].photos}
      </a>
      <a
        class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3.5 py-2 text-sm font-semibold text-white ring-1 ring-white/25 backdrop-blur-md transition hover:bg-white/20"
        href="#arredores"
      >
        {nearbyCopy[lang].link}
      </a>
    </div>

    <div
      class="home-hero__stats mt-6 max-w-2xl sm:mt-8"
    >
      {
        t.hero.stats.map((s) => (
          <div class="min-w-0 rounded-2xl bg-white/10 p-2 text-center sm:p-4 ring-1 ring-white/20 backdrop-blur-md">
            <div class="[overflow-wrap:anywhere] text-lg font-extrabold text-white sm:text-2xl">{s.num}</div>
            <div class="mt-1 text-xs font-medium text-white/80">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>

  <div
    class="absolute bottom-4 left-1/2 z-10 -translate-x-1/2 text-2xl text-white/80"
    aria-hidden="true"
  >
    ↓
  </div>
</section>
