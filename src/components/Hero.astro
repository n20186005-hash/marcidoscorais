---
import { type Lang } from "../config";
import type { Translation } from "../i18n/translations";

interface Props {
  lang: Lang;
  t: Translation;
}
const { t } = Astro.props;
---

<section
  id="top"
  class="relative flex min-h-[88vh] items-center overflow-hidden bg-ocean-dark isolate"
>
  <div
    class="absolute inset-0 bg-[url('/gallery/21.jpg')] bg-cover bg-center bg-no-repeat"
  >
  </div>
  <div
    class="absolute inset-0 bg-gradient-to-b from-black/55 via-black/35 to-black/45"
  >
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-[1120px] px-4 py-28 sm:px-8"
  >
    <span
      class="reveal inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-md"
    >
      📍 {t.hero.eyebrow}
    </span>

    <h1
      class="reveal mt-5 text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl"
    >
      {t.hero.title}
    </h1>

    <p
      class="reveal mt-5 max-w-2xl text-base leading-relaxed text-white/90 sm:text-lg"
    >
      {t.hero.subtitle}
    </p>

    <div class="reveal mt-8 flex flex-wrap gap-4">
      <a
        class="rounded-full bg-coral px-6 py-3 text-sm font-bold text-white shadow-lg transition hover:brightness-105"
        href={t.hero.primaryCta.href}
      >
        {t.hero.primaryCta.label}
      </a>
      <a
        class="rounded-full border border-white/70 bg-white/10 px-6 py-3 text-sm font-bold text-white backdrop-blur-md transition hover:bg-white/20"
        href={t.hero.secondaryCta.href}
      >
        {t.hero.secondaryCta.label}
      </a>
    </div>

    <div
      class="reveal mt-10 grid max-w-2xl grid-cols-2 gap-4 sm:grid-cols-3"
    >
      {
        t.hero.stats.map((s) => (
          <div class="rounded-2xl bg-white/10 p-4 text-center ring-1 ring-white/20 backdrop-blur-md">
            <div class="text-2xl font-extrabold text-white">{s.num}</div>
            <div class="mt-1 text-xs font-medium text-white/80">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>

  <div
    class="absolute bottom-6 left-1/2 -translate-x-1/2 text-2xl text-white/80"
    aria-hidden="true"
  >
    ↓
  </div>
</section>
