---
import { type Lang } from "../config";
import { languagesList, langLabels } from "../i18n/ui";
import type { Translation } from "../i18n/translations";

interface Props {
  lang: Lang;
  t: Translation;
  page?: string;
}
const { lang, t, page = "" } = Astro.props;
// 当前页的基础路径（用于语言切换时保持同一页）
const pageSeg = page ? `${page}` : "";
---

<header class="site-nav" id="siteNav">
  <div
    class="site-nav__inner mx-auto flex w-full max-w-[1120px] items-center justify-between gap-6 px-4 sm:px-8"
  >
    <a
      class="site-nav__brand flex shrink-0 items-center gap-3 whitespace-nowrap text-lg font-extrabold tracking-tight text-ink no-underline"
      href={`/${lang}/`}
    >
      <span
        class="site-nav__brand-mark grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-ocean to-ocean-light text-white shadow-sm"
        >🪸</span
      >
      <span>{t.site.shortName}</span>
    </a>

    <nav aria-label="Primary">
      <ul class="site-nav__links flex items-center gap-5 whitespace-nowrap" id="navLinks">
        {
          t.nav.map((item) => (
            <li>
              <a
                class="whitespace-nowrap rounded-full px-3 py-2 text-sm font-semibold text-muted no-underline transition hover:bg-surface-2 hover:text-ocean"
                href={`/${lang}/#${item.id}`}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex-1"></div>

    <div class="site-nav__actions flex shrink-0 items-center gap-3">
      <div class="lang-menu" id="langMenu">
        <button
          class="lang-menu__btn"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          id="langMenuBtn"
        >
          <span>{langLabels[lang].code}</span>
          <span aria-hidden="true">▾</span>
        </button>
        <ul class="lang-menu__list" role="menu">
          {
            languagesList.map((l) => (
              <li>
                <a
                  href={pageSeg ? `/${l}/${pageSeg}` : `/${l}/`}
                  role="menuitem"
                  aria-current={l === lang ? "true" : "false"}
                >
                  <span>{langLabels[l].code}</span>
                  <span class="lang-native">{langLabels[l].native}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <button
        class="theme-toggle"
        type="button"
        id="themeToggle"
        aria-label="Toggle theme"
      >
        <span class="theme-toggle__icon">🌙</span>
      </button>

      <button class="nav-toggle" type="button" id="navToggle" aria-label="Menu">
        ☰
      </button>
    </div>
  </div>
</header>
