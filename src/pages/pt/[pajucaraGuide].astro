---
import Layout from "../../layouts/Layout.astro";
import TopicPage from "../../components/TopicPage.astro";
import { pajucaraGuides } from "../../data/pajucara-guides";
import { getTranslation } from "../../i18n/translations";

export function getStaticPaths() {
  return Object.entries(pajucaraGuides).map(([slug, topic]) => ({
    params: { pajucaraGuide: slug },
    props: { topic },
  }));
}

const slug = Astro.params.pajucaraGuide;
const { topic } = Astro.props;
const t = getTranslation("pt");
---
<Layout lang="pt" t={t} page={slug} title={topic.metaTitle} description={topic.metaDescription} availableLangs={["pt"]}>
  <TopicPage lang="pt" topic={topic} t={t} />
</Layout>
