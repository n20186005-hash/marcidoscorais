---
import Layout from "../../layouts/Layout.astro";
import TopicPage from "../../components/TopicPage.astro";
import { getNearbyVisitPlan, nearbyGuides, nearbySlugs } from "../../i18n/nearby-guides";
import { languagesList } from "../../i18n/ui";
import { getTranslation } from "../../i18n/translations";

export function getStaticPaths() {
  return nearbySlugs.map((slug) => ({
    params: { pajucaraGuide: slug },
    props: { topic: nearbyGuides[slug], visitPlan: getNearbyVisitPlan("pt", slug) },
  }));
}

const slug = Astro.params.pajucaraGuide;
const { topic, visitPlan } = Astro.props;
const t = getTranslation("pt");
---
<Layout lang="pt" t={t} page={slug} title={topic.metaTitle} description={topic.metaDescription} availableLangs={languagesList}>
  <TopicPage lang="pt" topic={topic} t={t} visitPlan={visitPlan} />
</Layout>
