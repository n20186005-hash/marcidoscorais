---
import Layout from "../../layouts/Layout.astro";
import TopicPage from "../../components/TopicPage.astro";
import { getTranslation } from "../../i18n/translations";
import { getTopic, type TopicSlug } from "../../i18n/topics";

const lang = "pt";
const t = getTranslation(lang);
const slug: TopicSlug = "o-que-fazer-em-maceio";
const topic = getTopic(lang, slug)!;
---
<Layout
  lang={lang}
  t={t}
  page={slug}
  title={topic.metaTitle}
  description={topic.metaDescription}
  availableLangs={["pt", "en", "es"]}
>
  <TopicPage lang={lang} topic={topic} t={t} />
</Layout>
